@page
@model IndexModel
@{
    ViewData["Title"] = "Zoo Visitors App";
}

<h1>Welcome to the Zoo Visitors App</h1>

<form method="post">

    <label>Enter the animal's hunger level (1-10):</label>
    <input type="number" name="hungerLevel" min="1"  max="10" required />

    <br><br>

    <label>Enter the day of the week (1-7, where 1 is Sunday):</label>
    <input type="number" name="dayOfWeek" min="1"  max="7" required />

    <br><br>

    <button type="submit">Getting the results</button>
</form>

@if (Model.ShowResults)
{
    <h2>Based on your results:</h2>
    <p><strong>What is your hunger level: </strong>@Model.HungerMessage</p>
    <p>@Model.HungerMessage</p>
    <p>Listening to the sound of the animals!!!</p>
    <p>@Model.SoundMessage</p>
    <p><strong> The day of the week it is: @Model.DayMessage !!! </strong></p>
}